# Configuration file for IIT Bombay Placement & Blog Monitor
# Copy this file to config.env and fill in your details:

# 1. Google Sheets Spreadsheet ID (Found in your Google Sheet URL between /d/ and /edit)
SPREADSHEET_ID=your_google_sheet_id_here

# 2. Google Cloud Service Account Credentials file name (must be in the same folder)
GOOGLE_CREDENTIALS_FILE=credentials.json

# 3. IIT Bombay Portal Authentication Token
# (To get this: log in to https://campus.placements.iitb.ac.in/applicant/home,
# open DevTools Console (F12) and run: copy(localStorage.getItem('token'))
# Paste it below or in token.txt):
PORTAL_TOKEN=

# 3a. InstiApp session id (for placement blog / test monitoring - no SSO needed)
# (To get this: open https://www.insti.app/blog/ in your logged-in browser,
# DevTools Console (F12) and run: copy(localStorage.getItem('sessionid'))
# Paste it below or in insti_token.txt):
INSTI_SESSION_ID=

# 4. Target Degree / Program Name for Salary Extraction
# Default: "B.Tech." (Other options: "M.Tech.", "Dual Degree", "M.Sc.", etc.)
TARGET_PROGRAM=B.Tech.

# 5. Discord Webhook URL for Alerts (Optional - leave empty if not needed)
DISCORD_WEBHOOK_URL=

# 5a. Channel-specific Discord webhooks (Optional - each falls back to DISCORD_WEBHOOK_URL)
# Create per-channel: Server Settings > Integrations > Webhooks > New Webhook
DISCORD_WEBHOOK_NEW_JAFS=
DISCORD_WEBHOOK_TESTS=
DISCORD_WEBHOOK_REMINDERS=

# 6. Check interval in seconds (default: 900 = 15 minutes)
CHECK_INTERVAL_SECONDS=900
